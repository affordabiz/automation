NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Affordabiz
# Set to 1 or true to log emails instead of sending (used by e2e)
BREVO_DRY_RUN=
# Optional. A dedicated subdomain with Brevo inbound MX records, e.g. reply.yourdomain.com
BREVO_INBOUND_DOMAIN=
# Random secret added to the Brevo inbound webhook URL as ?token=
BREVO_INBOUND_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses database security, so never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
